rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * FIRESTORE SECURITY RULES - PROTOTYPING PHASE
     * تم تبسيط القواعد لضمان تجربة تطوير سلسة للبروتوكول
     */

    // --- HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // في مرحلة البروتوتايب، نعتبر كل مستخدم مسجل دخول له صلاحيات واسعة لإدارة فعاليته
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow read, write: if isSignedIn(); 
    }

    match /events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn(); 
    }

    match /orders/{orderId} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /tickets/{ticketId} {
      allow read: if true; 
      // السماح بإنشاء التذاكر (بما فيها المادية Unclaimed) لأي مستخدم مسجل
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    match /resales/{resaleId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}